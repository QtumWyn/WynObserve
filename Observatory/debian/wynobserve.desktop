[Desktop Entry]
Type=Application
Name=WynObserve
GenericName=Fleet Observatory
Comment=Distributed system telemetry and fleet observability
Exec=/usr/bin/wynobserve --config /etc/wyncommand/observatory-prod.toml
TryExec=/usr/bin/wynobserve
Icon=wynobserve
Terminal=false
Categories=System;Monitor;
StartupNotify=true
